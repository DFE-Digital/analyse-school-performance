@using ASP.Web.Core.Templating
@model ContentTemplateEditModel

@{
    ViewData["Title"] = "Edit: " + Model.PageTitle;
}

@*  
    Edit view for component tests to allow embedding a single component editor, which can be saved by
    dynamically pressing the Save button (posts to ComponentTestController.Edit())

    Allows components to be tested independently of any controllers defined in the web application, so
    keeping application and test code separate
*@
<form id="test-form" method="POST">
    @* 
        Giving test div an explicit size so it is always visible regardless of its content
        (Playwright assertions wait until the element is visible on the page)
    *@
    <div id="test" style="border: 1px solid black; padding: 10px">
        <span>This is the test container</span>
        <div>
            @await Html.PartialAsync("~/Features/ContentTemplates/ContentTemplateEdit.cshtml", Model)
        </div>
    </div>
    <button id="test-save" type="submit">Save</button>
</form>