@model TemplateComponentViewModel
@inject MarkdownHelper MarkdownHelper

@{
    Model.ViewContent.Headings ??= new List<string>();
    Model.ViewContent.Rows ??= new List<List<string>> { new List<string>() };
    
    bool firstCellAsHeader = Model.ViewContent.FirstCellAsHeader as bool? ?? false;

    int maxCellCount = Model.ViewContent.Headings.Count;
    foreach (var row in Model.ViewContent.Rows)
    {
        maxCellCount = Math.Max(maxCellCount, row.Count);
    }
}


<table class="govuk-table" id="@Model.ViewContent.Id">
    @if (!string.IsNullOrWhiteSpace(Model.ViewContent.Caption))
    {
        <caption class="govuk-table__caption govuk-table__caption--m">@Model.ViewContent.Caption</caption>
    }
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            @foreach (var heading in Model.ViewContent.Headings)
            {
                <th scope="col" class="govuk-table__header">@heading</th>
            }
            @for (int i = Model.ViewContent.Headings.Count; i < maxCellCount; i++)
            {
                <th scope="col" class="govuk-table__header"></th>
            }
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var row in Model.ViewContent.Rows)
        {
            <tr class="govuk-table__row">
                @for (int j = 0; j < row.Count; j++)
                {
                    if (firstCellAsHeader && j is 0)
                    {
                        <td class="govuk-table__header">@MarkdownHelper.ConvertInlineMarkdown(row[j])</td>
                    }
                    else
                    {
                        <td class="govuk-table__cell">@MarkdownHelper.ConvertInlineMarkdown(row[j])</td>
                    }
                }
                @for (int i = row.Count; i < maxCellCount; i++)
                {
                    <td class="govuk-table__cell"></td>
                }
            </tr>
        }
    </tbody>
</table>