@using Newtonsoft.Json.Linq

@model TemplateComponentViewModel
@inject AttributeHelper AttributeHelper

@{
    var (tag, size) = Model.ViewContent.HeadingType switch
    {
        "h3" => ("h3", "m"),
        JValue v => (v.Value switch {
            "h3" => ("h3", "m"),
            _ => ("h2", "l")
        }),
        _ => ("h2", "l")
    };

    var caption = Model.ViewContent.Caption switch {
        string s => s,
        JValue v => (v.Value switch {
            string s => s,
            _ => null
        }),
        _ => null
    };

    var linkUrl = Model.ViewContent.LinkUrl switch
    {
        string s => s,
        JValue v => (v.Value switch
        {
            string s => s,
            _ => null
        }),
        _ => null
    };

    var headingText = Model.ViewContent.Text switch
    {
        null => "Heading text",
        string s when !string.IsNullOrWhiteSpace(s) => s,
        string s when string.IsNullOrWhiteSpace(s) => "Heading text",
        bool b => JsonHelper.Serialize(b),
        double d => JsonHelper.Serialize(d),
        JArray a => JsonHelper.Serialize(a),
        JObject o => JsonHelper.Serialize(o),
        JValue v => (v.Value switch {
            null => "Heading text",
            string s when !string.IsNullOrWhiteSpace(s) => s,
            string s when string.IsNullOrWhiteSpace(s) => "Heading text",
            bool b => JsonHelper.Serialize(b),
            double d => JsonHelper.Serialize(d),
            _ => Model.ViewContent.Text.ToString()
        }),
        _ => Model.ViewContent.Text.ToString()
    };
}

<@tag class="govuk-heading-@size">
    @if (!string.IsNullOrWhiteSpace(caption))
    {
        <span class="govuk-caption-@size">@caption</span>
    }

    @if (!string.IsNullOrWhiteSpace(linkUrl))
    {
        <a href="@linkUrl" class="govuk-link" target="@AttributeHelper.SetTargetAttribute(linkUrl)">
            @headingText
        </a>
    }
    else
    {
        @headingText
    }
</@tag>