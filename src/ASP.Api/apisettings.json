{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "CosmosDb": {
        "EndpointUri": "https://s192d01-cdb-dev.documents.azure.com:443/",
        "DatabaseId": "asp",
        "Containers": [
            {
                "content": {
                    "ContainerName": "content",
                    "PartitionKey": "/contentId"
                },
                "establishments": {
                    "ContainerName": "establishments",
                    "PartitionKey": "/urn"
                },
                "local-authorities": {
                    "ContainerName": "local-authorities",
                    "PartitionKey": "/code"
                },
                "multi-academy-trusts": {
                    "ContainerName": "multi-academy-trusts",
                    "PartitionKey": "/id"
                }
            }
        ]
    },
    "ErrorHandling": {
        "ShowStackTrace": true
    },
    "DocumentDatabase": {
        "InMemory": false
    },
    "BlobStorage": {
        "InMemory": false
    },
    "DataDownloads": {
        "DownloadsConfigContainerName": "config",
        "DownloadsConfigFileName": "downloads-config.json",
        "SourceContainerNames": {
            "ASP": "downloads-asp",
            "KTS": "downloads-kts"
        }
    }
}