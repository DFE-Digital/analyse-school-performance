            "ASP": "downloads-asp",
            "KTS": "downloads-kts"
        }
    },
    "DocumentDatabase": {
        "InMemory": false,
        "EndpointUri": null,             // local, deployed
        "PrimaryKey": null,              // local only
        "ManagedIdentityClientId": null, // deployed only
        "DatabaseId": "asp",
        "Containers": {
            "content": {
                "ContainerName": "content",
                "PartitionKey": "/contentId"
            },
            "establishments": {
