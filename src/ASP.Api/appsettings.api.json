        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "AzureKeyVault": {
        "KeyVaultName": null             // deployed only
    },
    "BlobStorage": {
        "InMemory": false,
        "StorageAccountName": null,      // local, deployed
