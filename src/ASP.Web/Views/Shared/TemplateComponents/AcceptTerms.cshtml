@{
    // Read the "ref-url" query string parameter
    string? referrer = Context.Request.Query["ref-url"];
}

@using (Html.BeginForm("accept-terms-of-use", "help", new { referrer = referrer }, FormMethod.Post))
{
    <div class="govuk-button-group">
        <button type="submit" id="app-accept-terms-button" class="govuk-button" data-module="govuk-button">
            Continue
        </button>
    </div>
}