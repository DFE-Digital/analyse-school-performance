@model TemplateComponentViewModel
@inject MarkdownHelper MarkdownHelper


@{
    var @class = Model.ViewContent.IsLarge switch {
        true => "govuk-body-l",
        "true" => "govuk-body-l",
        _ => "govuk-body"
    };

    var text = Model.ViewContent.Text switch {
        null => "Paragraph text",
        string s when !string.IsNullOrWhiteSpace(s) => s,
        string s when string.IsNullOrWhiteSpace(s) => "Paragraph text",
        bool b => JsonHelper.Serialize(b),
        double d => JsonHelper.Serialize(d),
        JArray a => JsonHelper.Serialize(a),
        JObject o => JsonHelper.Serialize(o),
        _ => Model.ViewContent.Text.ToString()
    };
}

<p id="@Model.ViewContent.Id" class=@(@class)>
    @MarkdownHelper.ConvertInlineMarkdown(text)
</p>