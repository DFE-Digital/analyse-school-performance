@model PageContentTemplateView
@{
    string componentsLocation = "TemplateComponents";
}


@if (Model.ChildViews is not null && Model.ChildViews.Count > 0)
{
    <ul id="@Model.ViewContent.Id" class="govuk-list govuk-list--bullet">
        @foreach (PageContentTemplateView item in Model.ChildViews)
        {
            @await Html.PartialAsync($"{componentsLocation}/{item.ViewId}", item)
        }
    </ul>
}
