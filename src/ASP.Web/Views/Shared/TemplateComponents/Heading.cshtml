@model PageContentTemplateView

@{
    var (tag, size) = Model.ViewContent.HeadingType switch {
        "h3" => ("h3", "m"),
        _ => ("h2", "l")
    };
}

<@tag id="@Model.ViewContent.Id" class="govuk-heading-@size">
    @if (Model.ViewContent.Caption is not null)
    {
        <span class="govuk-caption-@size">@Model.ViewContent.Caption</span>
    }

    @if (Model.ViewContent.LinkUrl is not null)
    {
        <a href="@Model.ViewContent.LinkUrl" class="govuk-link">
            @Model.ViewContent.Text
        </a>
    }
    else
    {
        @Model.ViewContent.Text
    }
</@tag>