@model EditViewComponentModel

@{
    var id = "Id";
    if (!Model.ViewContent.ContainsKey(id))
    {
        Model.ViewContent[id] = "";
    }

    var size = "Size";
    if (!Model.ViewContent.ContainsKey(size))
    {
        Model.ViewContent[size] = "";
    }

    var caption = "Caption";
    if (!Model.ViewContent.ContainsKey(caption))
    {
        Model.ViewContent[caption] = "";
    }

    var captionSize = "CaptionSize";
    if (!Model.ViewContent.ContainsKey(captionSize))
    {
        Model.ViewContent[captionSize] = "";
    }

    var text = "Text";
    if (!Model.ViewContent.ContainsKey(text))
    {
        Model.ViewContent[text] = "";
    }

    var linkUrl = "LinkUrl";
    if (!Model.ViewContent.ContainsKey(linkUrl))
    {
        Model.ViewContent[linkUrl] = "";
    }
}

<div id="@Model.ViewContent[id]" class="govuk-fieldset">
    <input type="hidden" asp-for="ViewId" />

    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
        <h1 class="govuk-fieldset__heading">
            @Model.ViewId
        </h1>
    </legend>

    <div class="govuk-form-group">
        <label for="@Html.IdFor(m => m.ViewContent[size])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Size</label>
        <select asp-for="ViewContent[size]" class="govuk-select asp-content-edit-heading-size">
            <option value="xl">XL</option>
            <option value="l">L</option>
            <option value="m">M</option>
            <option value="s">S</option>
        </select>

        <label for="@Html.IdFor(m => m.ViewContent[caption])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Caption</label>
        <input asp-for="ViewContent[caption]" class="govuk-input asp-content-edit-heading-caption" />

        <label for="@Html.IdFor(m => m.ViewContent[captionSize])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Caption size</label>
        <select asp-for="ViewContent[captionSize]" class="govuk-select asp-content-edit-caption-size">
            <option value="xl">XL</option>
            <option value="l">L</option>
            <option value="m">M</option>
        </select>

        <label for="@Html.IdFor(m => m.ViewContent[text])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Text</label>
        <input asp-for="ViewContent[text]" class="govuk-input asp-content-edit-heading-text" />

        <label for="@Html.IdFor(m => m.ViewContent[linkUrl])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Link URL</label>
        <input asp-for="ViewContent[linkUrl]" class="govuk-input asp-content-edit-heading-link-url" />
    </div>
</div>