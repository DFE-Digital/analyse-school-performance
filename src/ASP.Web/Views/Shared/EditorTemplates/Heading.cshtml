@model HeadingEditModel

<div class="govuk-fieldset app-component-edit">
    <input type="hidden" asp-for="ViewId" />

    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
        <h1 class="govuk-fieldset__heading">
            @Model.ViewId
        </h1>
    </legend>

    <div class="govuk-form-group">
        <label for="@Html.IdFor(m => m.ViewContent[HeadingEditModel.HeadingType])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Heading Type</label>
        <select asp-for="ViewContent[HeadingEditModel.HeadingType]" class="govuk-select app-content-edit-heading-type">
            <option value="h2">H2</option>
            <option value="h3">H3</option>
        </select>

        <label for="@Html.IdFor(m => m.ViewContent[HeadingEditModel.Caption])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Caption</label>
        <input asp-for="ViewContent[HeadingEditModel.Caption]" class="govuk-input app-content-edit-heading-caption" />

        <label for="@Html.IdFor(m => m.ViewContent[HeadingEditModel.Text])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Text</label>
        <input asp-for="ViewContent[HeadingEditModel.Text]" class="govuk-input app-content-edit-heading-text" />

        <label for="@Html.IdFor(m => m.ViewContent[HeadingEditModel.LinkUrl])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Link URL</label>
        <input asp-for="ViewContent[HeadingEditModel.LinkUrl]" class="govuk-input app-content-edit-heading-link-url" />
    </div>
</div>