@model ParagraphEditModel

<div class="govuk-fieldset app-component-edit">
    <input type="hidden" asp-for="ViewId" />

    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
        <h1 class="govuk-fieldset__heading">
            @Model.ViewId
        </h1>
    </legend>

    <div class="govuk-form-group">
        <label for="@Html.IdFor(m => m.ViewContent[ParagraphEditModel.Size])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Size</label>
        <select asp-for="ViewContent[ParagraphEditModel.Size]" class="govuk-select">
            <option value="l">L</option>
            <option value="m">M</option>
            <option value="s">S</option>
            <option value="xs">XS</option>
        </select>

        <label for="@Html.IdFor(m => m.ViewContent[ParagraphEditModel.Text])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Text</label>
        <textarea asp-for="ViewContent[ParagraphEditModel.Text]" class="govuk-textarea" rows="5">

        </textarea>
    </div>
</div>