@model ParagraphEditModel

<div class="govuk-fieldset app-component-edit">
    <input type="hidden" asp-for="ViewId" />

    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
        <h1 class="govuk-fieldset__heading">
            @Model.ViewId
        </h1>
    </legend>

    <div class="govuk-form-group">
        <label for="@Html.IdFor(m => m.ViewContent[ParagraphEditModel.IsLarge])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Is Large</label>
        <input type="checkbox" asp-for="ViewContent[ParagraphEditModel.IsLarge]" value="true" />

        <label for="@Html.IdFor(m => m.ViewContent[ParagraphEditModel.Text])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">Text</label>
        <textarea asp-for="ViewContent[ParagraphEditModel.Text]" class="govuk-textarea" rows="5">

        </textarea>
    </div>
</div>