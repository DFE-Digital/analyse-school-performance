@model EditViewComponentModel

<div class="govuk-fieldset">
    <input type="hidden" asp-for="ViewId" />
    
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
        <h1 class="govuk-fieldset__heading">
            @Model.ViewId
        </h1>
    </legend>

    <div class="govuk-form-group">
        @foreach(var kvp in Model.ViewContent) {
            <label for="@Html.IdFor(m => m.ViewContent[@kvp.Key])" class="govuk-label govuk-!-margin-top-2 govuk-!-font-weight-bold">
                @kvp.Key
            </label>
            <input asp-for="ViewContent[kvp.Key]" class="govuk-input" />
        }
    </div>
</div>