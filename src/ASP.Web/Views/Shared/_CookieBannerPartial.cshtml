@using ASP.Core.Enums

@{
    var cookiePreferences = ViewData["CookiePreferences"] as CookiePreferencesModel;
}

@if (cookiePreferences?.AnalyticsTracking == AnalyticsTracking.NotSet)
{
    <div id="app-cookie-banner" class="govuk-cookie-banner" data-nosnippet role="region" aria-label="Cookies on Analyse school performance">
        <div class="govuk-cookie-banner__message govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h2 class="govuk-cookie-banner__heading govuk-heading-m">Cookies on Analyse school performance</h2>
                    <div class="govuk-cookie-banner__content">
                        <p class="govuk-body">We use some essential cookies to make this service work.</p>
                        <p class="govuk-body">We’d also like to use analytics cookies so we can understand how you use the service and make improvements.</p>
                    </div>
                </div>
            </div>
            @using (Html.BeginForm("CookiesPreferences", "Cookies", FormMethod.Post, new { @id = "app-cookie-banner-preferences-form" }))
            {
                <div class="govuk-button-group">
                    <button id="app-cookie-banner-accept-button" value="Accepted" type="submit" name="analyticsTracking" class="govuk-button" data-module="govuk-button">
                        Accept analytics cookies
                    </button>
                    <button id="app-cookie-banner-reject-button" value="Rejected" type="submit" name="analyticsTracking" class="govuk-button" data-module="govuk-button">
                        Reject analytics cookies
                    </button>
                    <a id="app-cookie-banner-view-cookies-link" class="govuk-link" href="/help/cookies">View cookies</a>
                </div>
            }
        </div>
    </div>
}
@if (cookiePreferences?.AnalyticsTrackingConfirmation == AnalyticsTrackingConfirmation.ShowBanner)
{
    <div id="app-cookie-confirmation-banner" class="govuk-cookie-banner" data-nosnippet role="region" aria-label="Cookies on Analyse school performance">
        <div class="govuk-cookie-banner__message govuk-width-container">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <div class="govuk-cookie-banner__content">
                        <p id="app-cookie-confirmation-banner-message" class="govuk-body">
                            You have @(cookiePreferences.AnalyticsTracking == AnalyticsTracking.Accepted ? "accepted" : "rejected") additional cookies.
                            You can
                            <a class="govuk-link" href="/help/cookies">change your cookie settings</a>
                            at any time.
                        </p>
                        <a asp-controller="cookies" asp-action="cookiesconfirmation" role="button" draggable="false" class="govuk-button">
                            Hide this message
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}