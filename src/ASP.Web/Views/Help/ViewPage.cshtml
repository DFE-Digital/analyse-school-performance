@model ContentTemplateViewModel

@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="govuk-width-container govuk-!-static-padding-top-5">
    <h1 class="govuk-heading-xl">@Model.PageTitle</h1>

    <a id="app-content-edit" asp-route="app-route-help-edit" asp-route-contentId="@Model.ContentId" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
        Edit this page
    </a>

    @await Html.PartialAsync("ContentTemplateView", Model)
</div>