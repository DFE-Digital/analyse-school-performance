@model EditContentPageModel

@{
    ViewData["Title"] = "Edit: " + Model.PageTitle;
}

<form method="POST">
    <input type="hidden" asp-for="Id" />
    <div class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
            <h1 class="govuk-fieldset__heading">
                Page title
            </h1>
        </legend>
        <div class="govuk-form-group">
            <label for="@Html.IdFor(m => m.PageTitle)" class="govuk-label govuk-!-font-weight-bold">
                Text
            </label>
            <input asp-for="PageTitle" class="govuk-input">
        </div>
    </div>

    @for (var i = 0; i < Model.Views.Count; i++)
    {
        @Html.EditorFor(m => m.Views[i], Model.Views[i].ViewId)
    }

    <button class="govuk-button" type="submit">Save</button>
</form>