@model ContentTemplateEditModel

@{
    ViewData["Title"] = "Edit: " + Model.PageTitle;
}

<form id="app-content-edit-form" method="POST">
    <div class="govuk-fieldset">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
            <h1 class="govuk-fieldset__heading">
                Page title
            </h1>
        </legend>
        <div class="govuk-form-group">
            <label for="@Html.IdFor(m => m.PageTitle)" class="govuk-label govuk-!-font-weight-bold">
                Text
            </label>
            <input type="text" id="app-content-edit-page-title" asp-for="PageTitle" class="govuk-input">
        </div>
    </div>

    @await Html.PartialAsync("ContentTemplateEdit", Model)

    <button id="app-content-edit-save" class="govuk-button" type="submit">Save</button>
    <a id="app-content-edit-cancel" asp-route="app-route-help-view" asp-route-contentId="@Model.ContentId" role="button" draggable="false" class="govuk-button govuk-button--secondary">
        Cancel
    </a>
</form>