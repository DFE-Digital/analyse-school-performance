@using ASP.Core.Utilities
@model ASP.Web.Features.DataDownloads.DownloadDataSelectFormatViewModel

<p class="govuk-body">You can download your requested data in @Model.FileFormatList format.</p>
<p class="govuk-body" data-testid="select-format-description">The data included in your download is the pupil level / aggregated data for your @Model.SchoolOrLaLevel.</p>
<ul class="govuk-list" data-testid="available-downloads-formats">
    @foreach (var (text, link) in Model.DownloadLinks)
    {
        <li>
            <img src="/assets/public/images/icons/download-icon.png" alt="download icon" class="app-icon-download">
            <a href="@link">@text</a>

            <span class="app-download-helptext">
                (will download as a ZIP file; open the ZIP to access its contents)
            </span>
        </li>
    }
</ul>
<a role="button" href="@Model.DownloadOtherDatesUrl" 
   data-testid="available-downloads-other-dates" 
   class="govuk-button govuk-button--secondary govuk-!-margin-top-4">
    Download other dates
</a>