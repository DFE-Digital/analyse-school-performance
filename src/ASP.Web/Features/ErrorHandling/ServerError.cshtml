@{
    ViewData["Title"] = "Sorry, there is a problem with the service";
}

<div class="govuk-width-container">
    <main class="govuk-main-wrapper govuk-main-wrapper--l" id="main-content" role="main">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-l">Sorry, there is a problem with the service</h1>
                <p class="govuk-body">Try again later.</p>
                <p class="govuk-body">A report of the error has been sent to our technical team</p>
                <p class="govuk-body">We will fix it as soon as possible. You can:</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li>use the back button and try another link</li>
                    <li>reload the page</li>
                    <li>come back later</li>
                </ul>
                @if (Model.ShowErrorCode)
                {
                    <p class="govuk-body" data-testid="error-display-code">
                        <strong>Error code:</strong> <code class="govuk-body">@Model.ErrorCode</code>
                    </p>
                }
                @if (Model.ShowErrorMessage)
                {
                    <p class="govuk-body" data-testid="error-display-message">
                        <strong>Error message:</strong> <code class="govuk-body">@Model.ErrorMessage</code>
                    </p>
                }
            </div>
        </div>
    </main>
</div>
