@{
    // Read the "referrer" query string parameter
    string? referrer = Context.Request.Query["referrer"];
}

@using (Html.BeginForm("Accept", "TermsOfUse", new { referrer = referrer }, FormMethod.Post))
{
    <div class="govuk-button-group">
        <button type="submit" id="app-accept-terms-button" class="govuk-button" data-module="govuk-button">
            Continue
        </button>
    </div>
}