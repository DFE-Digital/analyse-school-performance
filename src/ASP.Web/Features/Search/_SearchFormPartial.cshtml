@using ASP.Web.Features.Search
@using ASP.Web.Extensions
@model SearchFormViewModel
@{
    var hasSearchTermError = ViewData.ModelState.HasError(nameof(SearchParameters.Search));
}

<div class="govuk-grid-row" x-data="@Model.AlpineComponentName">
    <div class="govuk-grid-column-@Model.Width">
        <input type="hidden" id="suggestion" name="suggestion" x-model="suggestion" />

        <form id="searchForm" method="get"
              x-on:submit="handleSubmit"
              x-on:keydown.enter="handleSubmit">
            <div class="govuk-form-group">

                <label for="app-field-Search" class="govuk-label govuk-body">
                    @Model.InputLabel
                </label>

                <div asp-validation-group-for="searchTerm" data-testid="searchTermValidationGroup">

                    @if (hasSearchTermError)
                    {
                        <span id="app-field-Search-input-error" class="govuk-error-message">
                            @Model.InputValidationMessage
                        </span>
                    }
                    <div class="search-input-container">
                        <div id="suggestionSearchTermContainer" data-suggest-url="@(Model.SearchSuggestionUrl)"
                             class="js-enabled govuk-!-width-three-quarters @(hasSearchTermError ? "search-input--error" : "")"
                             aria-describedby="searchTerm-input-error">
                        </div>
                        <input type="text" id="app-field-Search"
                               class="js-disabled govuk-input govuk-!-width-three-quarters @(hasSearchTermError ? "search-input--error" : "")"
                               aria-describedby="searchTerm-input-error"
                               name="search" spellcheck="false" value="@Model.SearchTerm" />
                        <button id="searchSubmit" type="submit" class="govuk-button app-search-button">
                            <span class="govuk-visually-hidden">Search</span>
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>