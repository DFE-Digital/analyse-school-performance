{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "RepositoryOptions": {
        "Containers": [
            {
                "content": {
                    "ContainerName": "content",
                    "PartitionKey": "/contentId"
                },
                "establishments": {
                    "ContainerName": "establishments",
                    "PartitionKey": "/urn"
                },
                "local-authorities": {
                    "ContainerName": "local-authorities",
                    "PartitionKey": "/code"
                }
            }
        ]
    },
    "HttpApiOptions": {
        "EndpointBaseUrl": "http://localhost:7116/api/",
        "FunctionsKey": ""
    },
    "ErrorHandlingOptions": {
        "ShowStackTrace": true
    }
}