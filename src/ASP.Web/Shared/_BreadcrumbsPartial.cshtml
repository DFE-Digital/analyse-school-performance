@model BreadcrumbViewModel

<div class="govuk-breadcrumbs govuk-breadcrumbs--collapse-on-mobile">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item">
            <a id="app-breadcrumb-home" href="/" class="govuk-breadcrumbs__link">Home</a>
        </li>

        @foreach (var breadcrumb in Model.Breadcrumbs)
        {
            <li class="govuk-breadcrumbs__list-item">
                <a id="app-breadcrumb-@breadcrumb.TitleId"
                   href="@breadcrumb.Url"
                   class="govuk-breadcrumbs__link">@breadcrumb.Title</a>
            </li>
        }

        @if(!string.IsNullOrEmpty(Model.CurrentPageTitle))
        {
            <li id="app-breadcrumb-current-page" class="govuk-breadcrumbs__list-item" aria-current="page">
                @Model.CurrentPageTitle
            </li>
        }
        
    </ol>
</div>