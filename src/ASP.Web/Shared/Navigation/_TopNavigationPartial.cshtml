@using ASP.Web.Features.Authorization
@using ASP.Web.Shared.Navigation
@model PathString

<nav class="govuk-header__navigation app-header__navigation" id="header-navigation" role="navigation" aria-label="Primary navigation" aria-labelledby="label-navigation">
    <div class="govuk-width-container">
        <ul id="navigation" class="govuk-header__navigation-list app-header__navigation-list">
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("Home", "/", Model, testId: "home")) />
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("All local authorities", "/local-authorities/", Model, Policy.AccessToAllLocalAuthorities)) />
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("My local authority", "/my-local-authority/", Model, Policy.AccessToMyLocalAuthority)) />
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("All schools", "/schools/", Model, Policy.AccessToAllSchools)) />
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("My schools", "/my-schools/", Model, Policy.AccessToMySchools)) />
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("My school", "/my-school/", Model, Policy.AccessToMySchool, testId: "my-school")) />
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("Search", "/search/", Model, Policy.AccessToSearch)) />
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("Release timetable", "/help/release-timetable/", Model)) />
            <partial name="Navigation/_TopNavigationItemPartial" model=@(new NavigationItemViewModel("Guidance", "/help/guidance/", Model)) />
        </ul>
    </div>
</nav>