@using ASP.Web.Shared.Navigation
@model NavigationItemViewModel

@{
    var @class = Model.IsCurrent ? "app-header__navigation-item--current" : "app-header__navigation-item--not-selected";
}

<li
    data-testid=@(Model.TestId != null ? $"app-header-navigation-item-{Model.TestId}" : null)
    authorization-policy=@Model.Policy 
    class="govuk-header__navigation-item app-header__navigation-item @(@class)">
    <a class="govuk-header__link app-header__navigation-link" href=@Model.Path>
        @Model.Name
    </a>
</li>