@model (string Name, string Path, string Id)

<li data-testid="@Model.Id-navigation" class="govuk-header__navigation-item app-header__navigation-item @(Context.Request.Path.StartsWithSegments(Model.Path)? "app-header__navigation-item--current" : "")">
    <a id="header-navigation-link-@Model.Id" class="govuk-header__link app-header__navigation-link" href="@Model.Path">
        @Model.Name
    </a>
</li>