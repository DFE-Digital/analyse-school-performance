@using ASP.Web.Features.Search
@using ASP.Web.Shared.Components.SearchResults
@model SearchViewComponentModel
@{
}

@if (Model.Search is SearchFormViewModel searchForm)
{
    if(!string.IsNullOrEmpty(Model.SearchFormWidth))
    {
        searchForm.Width = Model.SearchFormWidth;
    }
    <partial name="Features/Search/_SearchFormPartial" model="searchForm" />

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <!-- listings go here -->
            @Html.Raw(Model.ChildContent)
        </div>
    </div>

    <partial name="Pagination/_PaginationPartial"
             model="@((searchForm.Pagination, "Footer"))" />
}
else if (Model.Search is SearchResultsNotFoundViewModel notFound)
{
    <partial name="Features/Search/_SearchResultNotFoundPartial" model="notFound" />
}