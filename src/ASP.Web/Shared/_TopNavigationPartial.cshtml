@using ASP.Web.Features.Authorization
@using ASP.Web.Shared
@model PathString

<nav class="govuk-header__navigation app-header__navigation" id="header-navigation" role="navigation" aria-label="Primary navigation" aria-labelledby="label-navigation">
    <div class="govuk-width-container">
        <ul id="navigation" class="govuk-header__navigation-list app-header__navigation-list">
            <partial name="_TopNavigationItemPartial" model=@(new NavigationItemViewModel("home", "Home", "/", Model)) />
            <partial name="_TopNavigationItemPartial" model=@(new NavigationItemViewModel("my-local-authority", "My local authority", "/my-local-authority/", Model, Policy.AccessToMyLocalAuthority)) />
            <partial name="_TopNavigationItemPartial" model=@(new NavigationItemViewModel("my-schools", "My schools", "/my-schools/", Model, Policy.AccessToMySchools)) />
            <partial name="_TopNavigationItemPartial" model=@(new NavigationItemViewModel("my-school", "My school", "/my-school/", Model, Policy.AccessToMySchool)) />
            <partial name="_TopNavigationItemPartial" model=@(new NavigationItemViewModel("search", "Search", "/search/", Model, Policy.AccessToSearch)) />
            <partial name="_TopNavigationItemPartial" model=@(new NavigationItemViewModel("release-timetable", "Release timetable", "/help/release-timetable/", Model)) />
            <partial name="_TopNavigationItemPartial" model=@(new NavigationItemViewModel("guidance", "Guidance", "/help/guidance/", Model)) />
        </ul>
    </div>
</nav>