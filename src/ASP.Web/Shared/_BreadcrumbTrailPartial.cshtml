@using ASP.Web.Core.BreadcrumbTrail
@model BreadcrumbTrailViewModel

<div class="govuk-breadcrumbs govuk-breadcrumbs--collapse-on-mobile">
    <ol class="govuk-breadcrumbs__list" data-testid="breadcrumbs">
        <li class="govuk-breadcrumbs__list-item">
            <a data-testid="breadcrumb-home" href="/" class="govuk-breadcrumbs__link">Home</a>
        </li>

        @foreach (var breadcrumb in Model.Breadcrumbs)
        {
            <li class="govuk-breadcrumbs__list-item">
                <a href="@breadcrumb.Url"
                   class="govuk-breadcrumbs__link">@breadcrumb.Title</a>
            </li>
        }

        <li data-testid="breadcrumb-current-page" class="govuk-breadcrumbs__list-item" aria-current="page">
            @Model.CurrentPageTitle
        </li>
    </ol>
</div>