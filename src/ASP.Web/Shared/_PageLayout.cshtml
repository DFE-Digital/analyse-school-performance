@{
    Layout = "~/Shared/_Layout.cshtml";
    var layoutModel = (ASP.Web.Shared.PageViewModel)ViewBag.PageLayoutModel;
    ViewData["Title"] = layoutModel.Title;
}

<div class="govuk-width-container app-width-container">
    <partial name="_BreadcrumbTrailPartial" model=@layoutModel.Breadcrumbs />

    <main id="main-content" role="main" class="govuk-main-wrapper govuk-main-wrapper--auto-spacing">
        @if (!ViewData.ModelState.IsValid)
        {
            <asp-error-summary>
                @foreach (var state in ViewData.ModelState)
                {
                    foreach (var error in state.Value.Errors)
                    {
                        <li>
                            <a data-testid="app-error-summary-@state.Key" href="#app-field-@state.Key">@error.ErrorMessage</a>
                        </li>
                    }
                }
            </asp-error-summary>
        }

        @RenderSection("PageTitle")

        @if (layoutModel.SubNavigation != null)
        {
            <partial name="Navigation/_SubNavigationPartial" model=@layoutModel.SubNavigation />
        }

        @if (layoutModel.SideNavigation != null)
        {
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-third app-side-navigation-width">
                    <partial name="Navigation/_SideNavigationPartial" model=@layoutModel.SideNavigation />
                </div>
                <div class="govuk-grid-column-two-thirds">
                    @if (layoutModel.ContentTitle != null || layoutModel.ContentTitleCaption != null)
                    {
                        <h2 id="app-subpage-title" class="govuk-heading-l app-downloads">
                            <span id="app-subpage-title-caption" class="govuk-caption-l">@layoutModel.ContentTitleCaption</span>
                            @layoutModel.ContentTitle
                        </h2>
                    }

                    @RenderBody()
                </div>
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>
</div>