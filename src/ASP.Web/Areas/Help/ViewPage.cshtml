@model ContentTemplateViewModel

@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="govuk-width-container app-width-container">
    <div class="govuk-breadcrumbs">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                <a id="app-breadcrumb-home" href="/" class="govuk-breadcrumbs__link">Home</a>
            </li>
            <li id="app-breadcrumb-current-page" class="govuk-breadcrumbs__list-item" aria-current="page">
                @Model.PageTitle
            </li>
        </ol>
    </div>
</div>

<div class="govuk-width-container govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-heading-xl">@Model.PageTitle</h1>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <a id="app-content-edit" asp-route="app-route-help-edit" asp-route-contentId="@Model.ContentId" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                Edit this page
            </a>

            @await Html.PartialAsync("~/Features/ContentTemplates/ContentTemplateView.cshtml", Model)
        </div>
    </div>
</div>