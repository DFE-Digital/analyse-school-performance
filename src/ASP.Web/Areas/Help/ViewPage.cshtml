@model ContentTemplateViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="govuk-width-container app-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.Breadcrumbs)

    <main id="main-content" role="main" class="govuk-main-wrapper">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 data-testid="content-page-title" class="govuk-heading-xl">@Model.PageTitle</h1>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <span authorization-policy="@Policy.AccessToEditPages">
                    <a data-testid="content-edit"
                       asp-route="app-route-help-edit"
                       asp-route-contentId="@Model.ContentId"
                       asp-route-revision="@Model.Revision"
                       role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                        Edit this page
                    </a>
                </span>
                @await Html.PartialAsync("~/Features/ContentTemplates/ContentTemplateView.cshtml", Model)
            </div>
        </div>
    </main>
</div>