@model ContentTemplateViewModel

@{
    var heroDescription = Model.PageContent?.HeroDescription switch
    {
        null => "Service description goes here...",
        Newtonsoft.Json.Linq.JValue v => v.Value switch
        {
            null => "Service description goes here...",
            _ => Model.PageContent?.HeroDescription
        },
        _ => Model.PageContent?.HeroDescription
    };
}

<section class="app-hero" id="app-hero">
    <div class="govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 id="app-page-title" class="govuk-heading-xl govuk-!-margin-bottom-4">
                    Analyse school performance
                </h1>
                <p class="govuk-body-l">
                    @heroDescription
                </p>
            </div>
        </div>
    </div>
</section>

<main id="main-content" role="main" class="govuk-width-container app-width-container govuk-main-wrapper">
    <div id="app-card-container" class="app-grid-container-three-column app-grid-container--wider govuk-!-margin-top-5">
        <partial name="Features/ContentTemplates/_ContentTemplateViewPartial" model="Model" />
    </div>
</main>