@using ASP.Web.Areas.Shared.EstablishmentListing
@using ASP.Web.Areas.Shared.Search.School
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ASP.Web.Areas.Shared.SchoolsPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="govuk-width-container app-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.Breadcrumbs)
</div>

<div class="govuk-width-container govuk-main-wrapper">
    @await Html.PartialAsync("~/Areas/Shared/Search/School/_SchoolSearchErrorSummaryPartial.cshtml")
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-4" data-testid="schools-title">@Model.Title</h1>
    <h2 class="govuk-heading-m" data-testid="schools-subtitle">@Model.SubTitle</h2>
    @await Html.PartialAsync("~/Areas/Shared/Search/School/_SchoolSearchFormPartial.cshtml",
        new SchoolSearchFormModel(Model.Controller, Model.ControllerAction, Model.SearchSuggestionUrl))
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @if (Model.TotalCount == 0)
            {
                <h1 id="schools-no-results-heading" data-testid="schools-no-results-heading"
                    class="govuk-heading-l school-name-heading">
                    We found no schools.
                </h1>
            }
        </div>
    </div>
    <div class="govuk-grid-row">
        @if (Model.TotalCount > 0)
        {
            <div class="govuk-grid-column-two-thirds">
                @await Html.PartialAsync("~/Areas/Shared/EstablishmentListing/_EstablishmentListingPartial.cshtml", new EstablishmentListingViewModel(Model.EstablishmentListingsModel))
                @if (Model.PaginationModel != null)
                {
                    <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml" model=@((Model.PaginationModel, "Footer"))/>
                }
            </div>
        }
    </div>
</div>