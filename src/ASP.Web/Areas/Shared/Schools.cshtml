@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ASP.Web.Areas.Shared.Search.School.SchoolSearchPageViewModel  
@{  
    Layout = "~/Areas/Shared/Search/Layout/SearchPageLayout/_SearchPageLayout.cshtml";  
    ViewBag.PageLayoutModel = Model.SearchPage;  
}  

<div class="govuk-grid-row">  
    @if (Model.EstablishmentListings.Count > 0)  
    {  
        <div class="govuk-grid-column-two-thirds">  
            <partial name="~/Areas/Shared/EstablishmentListing/_EstablishmentListingPartial.cshtml"   
                     model="Model.EstablishmentListings" />  

            @if (Model.SearchPage.Pagination != null)  
            {  
                <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml"   
                         model="@((Model.SearchPage.Pagination, "Footer"))" />  
            }  
        </div>  
    }  
    else  
    {  
        <div class="govuk-grid-column-two-thirds">  
            <h1 id="schools-no-results-heading"   
                data-testid="schools-no-results-heading"  
                class="govuk-heading-l school-name-heading">  
                We found no schools.  
            </h1>  
        </div>  
    }  
</div>  