@using ASP.Web.Areas.Shared.EstablishmentListing
@using ASP.Web.Areas.Shared.Search
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ASP.Web.Areas.Shared.Search.School.SchoolsPageSearchViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="govuk-width-container app-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.Breadcrumbs)

    <main id="main-content" role="main" class="govuk-main-wrapper govuk-main-wrapper--auto-spacing">
        @await Html.PartialAsync("~/Areas/Shared/Search/_SearchErrorSummaryPartial.cshtml")
        <h1 id="app-page-title" class="govuk-heading-xl govuk-!-margin-bottom-4" data-testid="schools-title">@Model.Title</h1>
        <h2 id="app-page-subtitle" class="govuk-heading-m" data-testid="schools-subtitle">@Model.SubTitle</h2>
        @await Html.PartialAsync("~/Areas/Shared/Search/_SearchFormPartial.cshtml",
            new SearchFormModel(Model.Controller, Model.ControllerAction, Model.SearchSuggestionUrl, Model.InputLabel, Model.InputValidationMessage))
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                @if (Model.TotalCount == 0)
                {
                    <h1 id="schools-no-results-heading" data-testid="schools-no-results-heading"
                        class="govuk-heading-l school-name-heading">
                        We found no schools.
                    </h1>
                }
            </div>
        </div>
        <div class="govuk-grid-row">
            @if (Model.TotalCount > 0)
            {
                <div class="govuk-grid-column-two-thirds">
                    @await Html.PartialAsync("~/Areas/Shared/EstablishmentListing/_EstablishmentListingPartial.cshtml", new EstablishmentListingViewModel(Model.EstablishmentListingsModel))
                    @if (Model.PaginationModel != null)
                    {
                        <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml" model=@((Model.PaginationModel, "Footer"))/>
                    }
                </div>
            }
        </div>
    </main>
</div>