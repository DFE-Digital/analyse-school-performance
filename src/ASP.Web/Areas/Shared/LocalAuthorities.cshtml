@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ASP.Web.Areas.Shared.Search.LocalAuthority.LocalAuthoritySearchPageViewModel  
@{  
    Layout = "~/Areas/Shared/Search/Layout/SearchPageLayout/_SearchPageLayout.cshtml";  
    ViewBag.PageLayoutModel = Model.SearchPage;  
}  

<div class="govuk-grid-row">  
    @if (Model.LocalAuthorityListings.Count > 0)  
    {  
        <div class="govuk-grid-column-two-thirds">  
            <partial name="~/Areas/Shared/LocalAuthorityListing/_LocalAuthoritiesListingPartial.cshtml"   
                     model="Model.LocalAuthorityListings" />  

            @if (Model.SearchPage.Pagination != null)  
            {  
                <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml"   
                         model="@((Model.SearchPage.Pagination, "Footer"))" />  
            }  
        </div>  
    }  
</div>  