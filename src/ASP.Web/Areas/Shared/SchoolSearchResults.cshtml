@using ASP.Web.Areas.Shared.Search.School
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model SchoolSearchResultsPageViewModel  
@{  
    Layout = "~/Areas/Shared/Search/Layout/SearchResultsPageLayout/_SearchResultsPageLayout.cshtml";  
    ViewBag.PageLayoutModel = Model.SearchResultsPage;  
}  

<div class="govuk-grid-row">  
    @if (Model.EstablishmentListings.Count > 0)  
    {  
        <div class="govuk-grid-column-two-thirds">  
            <partial name="~/Areas/Shared/EstablishmentListing/_EstablishmentListingPartial.cshtml"   
                     model="Model.EstablishmentListings" />

            <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml"
                     model="@((Model.SearchResultsPage.Pagination, "Footer"))" />
        </div>  
    }  
</div>  