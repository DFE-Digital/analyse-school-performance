@model ASP.Web.Areas.Shared.DownloadData.SelectFormat.DownloadDataSelectFormatModel

<div class="govuk-width-container app-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.Breadcrumbs)
</div>

<div class="govuk-main-wrapper govuk-width-container">
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">@Model.Title</h1>
     <h2 class="govuk-heading-m">
         @Html.Raw(Model.SubTitle)
    </h2>
    @await Html.PartialAsync("~/Areas/Shared/Navigation/_SubMenuNavigationPartial.cshtml", Model.SubNavigation)

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third app-side-navigation-width">
            @await Html.PartialAsync("~/Areas/Shared/Navigation/_SideMenuNavigationPartial.cshtml", Model.SideNavigation)
        </div>
        <div class="govuk-grid-column-two-thirds">
            <h2 data-testid="available-downloads-format-heading" class="govuk-heading-l app-downloads">
                <span data-testid="available-downloads-caption" class="govuk-caption-l">@Model.ContentTitleCaption</span>
                @Model.ContentTitle
            </h2>
            <p class="govuk-body">You can download your requested data in CSV format.</p>
            <p class="govuk-body">The data included in your download is the pupil level / aggregated data for your @Model.SchoolOrLaLevel.</p>
            <ul class="govuk-list">
                    <li>
                    <img src="/assets/public/images/icons/download-icon.png" alt="download icon" class="app-icon-download">
                    @Html.ActionLink(Model.LinkText, Model.ControllerActionName, Model.ControllerName, new { fileType = Model.FileType, selectedFiles = Model.SelectedFiles }, new { id = "app-available-downloads-format-csv-link", @class = "govuk-link" })
                        <span class="app-download-helptext">
                            (will download as a ZIP file; open the ZIP to access its contents)
                        </span>
                    </li>
            </ul>
            @Html.ActionLink("Download other dates", Model.ControllerActionName, Model.ControllerName,null, new { id = "app-available-downloads-other-dates-link", role="button", @class = "govuk-button govuk-button--secondary govuk-!-margin-top-4" })
        </div>
    </div>
</div>