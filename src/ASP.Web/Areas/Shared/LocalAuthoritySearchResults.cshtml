@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ASP.Web.Areas.Shared.Search.LocalAuthority.LocalAuthoritySearchResultsPageViewModel  
@{  
    Layout = "~/Areas/Shared/Search/Layout/SearchResultsPageLayout/_SearchResultsPageLayout.cshtml";  
    ViewBag.PageLayoutModel = Model.SearchResultsPage;  
}  

<div class="govuk-grid-row">  
    @if (Model.LocalAuthorityListings.Count > 0)  
    {  
        <div class="govuk-grid-column-two-thirds">  
            <partial name="~/Areas/Shared/LocalAuthorityListing/_LocalAuthoritiesListingPartial.cshtml"   
                     model="Model.LocalAuthorityListings" />

            <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml"
                     model="@((Model.SearchResultsPage.Pagination, "Footer"))" />
        </div>  
    }  
</div> 