@using ASP.Web.Areas.LocalAuthority
@model List<LocalAuthorityListingViewModel>
@{
    var counter = 1;
}
<ul class="govuk-list">
    @foreach (var item in Model)
    {
        <li>
            <div class="app-listing-result-tile">
                <h3 class="govuk-heading-s">
                    <a class="govuk-link" data-testid="all-local-authorities-listing-name-@counter" href="@item.Url">
                        @item.Name
                    </a>
                </h3>

                <dl class="govuk-list asp-summary-list">
                    <dt class="app-summary-list__key">Code:</dt>
                    <dd class="app-summary-list__value" data-testid="all-local-authorities-listing-code-@counter">@item.Code</dd>
                </dl>
            </div>
        </li>
        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible" />
        counter++;
    }
</ul>