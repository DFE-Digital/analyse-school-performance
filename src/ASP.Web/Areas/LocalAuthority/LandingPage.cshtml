@model ASP.Web.Areas.LocalAuthority.LocalAuthorityContentPageViewModel
@{
    ViewData["Title"] = Model.Page.Title;
}

<div class="govuk-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.Page.Breadcrumbs)
    <div class="govuk-width-container govuk-main-wrapper">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">@Model.Page.Title</h1>
        <h2 data-testid="all-school-in-la-sub-title" class="govuk-heading-m">All schools within @Model.Page.Name</h2>
        <div class="govuk-width-container">
            <div id="app-card-container" class="app-grid-container-three-column app-grid-container--wider govuk-!-margin-top-5">
                @await Html.PartialAsync("~/Features/ContentTemplates/ContentTemplateView.cshtml", Model.ContentTemplate)
            </div>
        </div>
    </div>
</div>