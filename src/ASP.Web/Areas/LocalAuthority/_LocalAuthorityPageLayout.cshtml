@{
    Layout = "~/Shared/_PageLayout.cshtml";
    var layoutModel = (ASP.Web.Shared.PageViewModel)ViewBag.LayoutModel;
    ViewBag.PageLayoutModel = layoutModel;
}

@section PageTitle {
    <h1 id="app-page-title" class="govuk-heading-xl govuk-!-margin-bottom-4">
        @layoutModel.Title
    </h1>
    <h2 id="app-page-subtitle" class="govuk-heading-m">
        @layoutModel.Subtitle
    </h2>
}

@RenderBody()