@using ASP.Web.Areas.LocalAuthority.Shared
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ASP.Web.Areas.LocalAuthority.LocalAuthoritiesPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="govuk-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.Breadcrumbs)
    <div class="govuk-width-container govuk-main-wrapper">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">@Model.Title</h1>
        <h2 class="govuk-heading-m">@Model.SubTitle</h2>
        <div class="govuk-grid-row">
            @if (Model.TotalCount > 0)
            {
                <div class="govuk-grid-column-two-thirds">
                    @await Html.PartialAsync("~/Areas/LocalAuthority/Shared/_LocalAuthoritiesListingPartial.cshtml", new LocalAuthoritiesListingViewModel(Model.Results))
                    @if (Model.PaginationModel != null)
                    {
                        <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml" model=@((Model.PaginationModel, "Footer"))/>
                    }
                </div>
            }
        </div>
    </div>
</div>