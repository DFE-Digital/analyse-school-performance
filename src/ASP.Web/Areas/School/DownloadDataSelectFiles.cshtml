@using ASP.Core
@using ASP.Web.Extensions
@model ASP.Web.Areas.School.ViewModels.SchoolDownloadsViewModel
@{
    ViewData["Title"] = "Download data";
    var hasSelectedFilesError = ViewData.ModelState.HasError(Constants.ModelErrorKeySelectedFiles);
}

<div class="govuk-width-container app-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.SchoolPage.Breadcrumbs)
</div>

<div class="govuk-main-wrapper govuk-width-container">
    @if (!ViewData.ModelState.IsValid)
    {
        <asp-error-summary>
            @{
                var selectedFilesError = ViewData.ModelState.GetFirstErrorForKey(Constants.ModelErrorKeySelectedFiles);
                if (selectedFilesError != null)
                {
                    <li>
                        <a href="#app-available-downloads-files" data-testid="app-available-downloads-files">@selectedFilesError.ErrorMessage</a>
                    </li>
                }
            }
        </asp-error-summary>
    }
    <h1 class="govuk-heading-xl">Download data</h1>
    <h2 id="school-name-heading" class="govuk-heading-m">
        @Model.SchoolPage.SchoolName <span class="govuk-!-font-weight-regular">(URN: @Model.SchoolPage.SchoolUrn)</span>
    </h2>
    @await Html.PartialAsync("~/Areas/Shared/Navigation/_SubMenuNavigationPartial.cshtml", Model.SchoolPage.SubNavigation)

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third app-side-navigation-width">
            @await Html.PartialAsync("~/Areas/Shared/Navigation/_SideMenuNavigationPartial.cshtml", Model.SchoolPage.SideNavigation)
        </div>
        <div class="govuk-grid-column-two-thirds">
            <h2 data-testid="available-downloads-files-heading" class="govuk-heading-l app-downloads">
                <span data-testid="available-downloads-files-name" class="govuk-caption-l">@Model.SchoolPage.SchoolName data</span>
                Data files available for download
            </h2>
            @using (Html.BeginForm("DownloadDataSelectFiles", Model.SchoolPage.Controller, FormMethod.Post, new { id = "app-available-downloads-files-form" }))
            {
                @Html.Hidden("selectedYear", Model.AvailableDownloads.AvailableDates.FirstOrDefault())
                <div class="govuk-form-group @(hasSelectedFilesError ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset" aria-describedby="app-available-downloads-files-hint">
                        <legend id="app-available-downloads-files-hint" class="govuk-fieldset__legend">
                            Select all that apply.
                        </legend>
                        <div class="govuk-checkboxes" data-module="govuk-checkboxes" id="app-available-downloads-files">
                            @if (hasSelectedFilesError)
                            {
                                <span id="app-available-downloads-files-error" data-testid="app-available-downloads-files-error" class="govuk-error-message">
                                    @Constants.DataFilesAvialableForDownlodValidationErrorMessage
                                </span>
                            }
                            @foreach (var group in Model.AvailableDownloads.Downloads.GroupBy(x => x.DatasetType).OrderBy(x => x.Key))
                            {
                                <h3 data-testid="available-downloads-file-group-@group.Key" class="govuk-heading-s govuk-!-font-weight-regular govuk-!-margin-top-6 govuk-!-margin-bottom-3">@group.Key</h3>

                                @foreach (var file in group)
                                {
                                    <div class="govuk-checkboxes__item">
                                        <input data-testid="available-downloads-file-@file.Id" id="app-available-downloads-file-@file.Id" class="govuk-checkboxes__input" name="selectedFiles"
                                               type="checkbox"
                                               value="@file.Id"
                                               aria-describedby="app-available-downloads-file-@file.Id-label">
                                        <label data-testid="available-downloads-file-@file.Id-label" id="app-available-downloads-file-@file.Id-label" class="govuk-label govuk-checkboxes__label" for="app-available-downloads-file-@file.Id">
                                            @($"{file.DatasetType} ({file.Version}) ({file.Source})")
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </fieldset>
                </div>
                <div class="govuk-button-group">
                    <button type="submit" id="selectedFilesSubmit" data-testid="selectedFilesSubmit" class="govuk-button" data-module="govuk-button">
                        Continue
                    </button>
                </div>
            }
        </div>
    </div>
</div>
