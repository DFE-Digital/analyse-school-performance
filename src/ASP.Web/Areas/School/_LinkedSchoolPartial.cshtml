@using ASP.Web.Areas.School
@model ASP.Web.Areas.School.LinkedEstablishmentsViewModel?

@{
    var counter = 1;
}

@if (Model != null && Model.Links.Any())
{
    <div class="govuk-inset-text" data-testid="linked-establishment">
        This establishment record is linked to other records, please follow the links to view data for these establishments:
        <ul>
            @foreach (var item in Model.Links)
            {
                <li data-testid="linked-establishment-description-@counter">
                    @Html.Raw(LinkConverter.ConvertToLinks(item.Description, Model.CreateSchoolUrl))
                </li>
                counter++;
            }
        </ul>
    </div>
}