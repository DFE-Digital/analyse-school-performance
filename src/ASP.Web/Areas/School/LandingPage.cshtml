@using ASP.Web.Areas.School
@model SchoolLandingPageViewModel
@{
    Layout = "_SchoolPageLayout";
    ViewBag.SchoolPageLayoutModel = Model.SchoolPage;
}

<partial name="_LinkedSchoolsPartial" model=Model.LinkedSchools />
<partial name="_SchoolDetailsPartial" model=Model.SchoolDetails/>

<div id="app-card-container" class="app-grid-container-four-column app-grid-container--wider govuk-!-margin-top-5">
    <partial name="Features/ContentTemplates/_ContentTemplateViewPartial" model=Model.ContentTemplate />
</div>