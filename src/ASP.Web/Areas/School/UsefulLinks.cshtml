@model ASP.Web.Areas.School.ViewModels.SchoolContentPageViewModel
@{
    Layout = "~/Areas/School/_SchoolPageLayout.cshtml";
    ViewBag.SchoolPageLayoutModel = Model.SchoolPage;
}

<ul class="app-links-list">
    @if (Model.ContentTemplate.Views != null)
    {
        foreach (var view in Model.ContentTemplate.Views)
        {
            <li>
                <partial name="~/Components/Link/View.cshtml" model=@view />
            </li>
        }
    }
</ul>