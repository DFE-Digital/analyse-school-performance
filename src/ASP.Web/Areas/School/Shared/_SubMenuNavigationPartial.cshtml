<nav aria-label="Sub navigation">
    <ul class="app-sub-navigation__list">
        <partial name="~/Areas/School/Shared/_SubMenuNavigationItemPartial.cshtml" model=@(("Other reports", $"/school/{Model.EstablishmentDetails.Urn}/other-reports", "other-reports")) />
        <partial name="~/Areas/School/Shared/_SubMenuNavigationItemPartial.cshtml" model=@(("Useful links", $"/school/{Model.EstablishmentDetails.Urn}/useful-links", "useful-links")) />
    </ul>
</nav>