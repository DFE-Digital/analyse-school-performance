<nav aria-label="Sub navigation">
    <ul class="app-sub-navigation__list">
        <partial name="~/Areas/School/Shared/_SubMenuNavigationItemPartial.cshtml" model=@(new NavigationItemViewModel("other-reports", "Other reports", $"{Model.BasePath}other-reports/", Model.RequestPath)) />
        <partial name="~/Areas/School/Shared/_SubMenuNavigationItemPartial.cshtml" model=@(new NavigationItemViewModel("useful-links", "Useful links", $"{Model.BasePath}useful-links/", Model.RequestPath)) />
    </ul>
