@using ASP.Core
@using ASP.Web.Extensions
@model ASP.Web.Areas.School.ViewModels.SchoolDownloadsViewModel
@{
    ViewData["Title"] = "Download data";
    var hasSelectedYearError = ViewData.ModelState.HasError(Constants.ModelErrorKeySelectedYear);
}

<div class="govuk-width-container app-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.SchoolPage.Breadcrumbs)
</div>

<div class="govuk-main-wrapper govuk-width-container">
    @if (!ViewData.ModelState.IsValid)
    {
        <asp-error-summary>
            @{
                var selectedYearError = ViewData.ModelState.GetFirstErrorForKey(Constants.ModelErrorKeySelectedYear);
                if (selectedYearError != null)
                {
                    <li>
                        <a href="#app-available-downloads-dates-select-option" data-testid="app-available-downloads-dates-select-option">@selectedYearError.ErrorMessage</a>
                    </li>
                }
            }
        </asp-error-summary>
    }
    <h1 class="govuk-heading-xl">Download data</h1>
    <h2 id="school-name-heading" class="govuk-heading-m">
        @Model.SchoolPage.SchoolName <span class="govuk-!-font-weight-regular">(URN: @Model.SchoolPage.SchoolUrn)</span>
    </h2>
    @await Html.PartialAsync("~/Areas/Shared/Navigation/_SubMenuNavigationPartial.cshtml", Model.SchoolPage.SubNavigation)

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third app-side-navigation-width">
            @await Html.PartialAsync("~/Areas/Shared/Navigation/_SideMenuNavigationPartial.cshtml", Model.SchoolPage.SideNavigation)
        </div>
        <div class="govuk-grid-column-two-thirds">
            <h2 data-testid="available-downloads-dates-heading" class="govuk-heading-l app-downloads">
                <span data-testid="available-downloads-dates-name" class="govuk-caption-l">@Model.SchoolPage.SchoolName data</span>
                Dates available for download
            </h2>
            @using (Html.BeginForm("DownloadDataSelectYear", Model.SchoolPage.Controller, FormMethod.Post, new { id = "app-available-download-dates-form" }))
            {
                <div class="govuk-form-group @(hasSelectedYearError ? "govuk-form-group--error" : "")">
                    <fieldset class="govuk-fieldset" aria-describedby="app-available-downloads-dates-hint">
                        <legend id="app-available-downloads-dates-hint" class="govuk-fieldset__legend">
                            Select one option
                        </legend>
                        <div class="govuk-radios" data-module="govuk-radios" id="app-available-downloads-dates-select-option">
                            @if (hasSelectedYearError)
                            {
                                <span id="app-available-downloads-dates-select-option-error" data-testid="app-available-downloads-dates-select-option-error" class="govuk-error-message">
                                    @Constants.AcademicYearToDownldValidationErrorMessage
                                </span>
                            }
                            @foreach (var year in Model.AvailableDownloads.AvailableDates)
                            {
                                <div class="govuk-radios__item">
                                    <input data-testid="available-downloads-dates-@year.Year" id="app-available-downloads-dates-@year.Year" class="govuk-radios__input" name="selectedYear"
                                           type="radio"
                                           value=@year.Year
                                           aria-describedby="app-available-downloads-dates-@year.Year-label">
                                    <label data-testid="available-downloads-dates-@year.Year-label"
                                           id="app-available-downloads-dates-@year.Year-label"
                                           class="govuk-label govuk-radios__label"
                                           for=app-available-downloads-dates-@year.Year>
                                        @year.StartToEndYears
                                    </label>
                                </div>
                            }
                        </div>
                    </fieldset>
                </div>
                <div class="govuk-button-group govuk-!-padding-top-5">
                    <button id="selectedYearSubmit" data-testid="selectedYearSubmit" type="submit" class="govuk-button" data-module="govuk-button">
                        Continue
                    </button>
                </div>
            }
        </div>
    </div>
</div>
