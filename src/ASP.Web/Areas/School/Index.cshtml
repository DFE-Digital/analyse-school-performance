@model ASP.Web.Areas.School.ViewModels.SchoolViewModel
@{
    ViewData["Title"] = "My school";
}

<div class="govuk-width-container govuk-main-wrapper">
    <h1 class="govuk-heading-xl">My school</h1>
    <div>
        <h1 class="govuk-heading-l">
            @Model.EstablishmentDetails.Name
            <span style="font-weight:400;">(URN: @Model.EstablishmentDetails.Urn)</span>
        </h1>
    </div>
    <details id="app-school-page-details" class="govuk-details">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">
                <span id="app-school-page-details-state-closed" class="app-school-details-closed">Show</span>
                <span id="app-school-page-details-state-open" class="app-school-details-open">Hide</span>
                school details
            </span>
        </summary>
        <div class="govuk-details__text">
            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-heading">
                        Detail type
                    </dt>
                    <dd class="govuk-summary-list__value app-school-details-summary-heading">
                        School details
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt id="app-school-details-address-key" class="govuk-summary-list__key app-school-details-summary-key">
                        Address
                    </dt>
                    <dd id="app-school-details-address-value" class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.Address == null
                            ? string.Empty
                            : $"{Model.EstablishmentDetails.Address.Street}, {Model.EstablishmentDetails.Address.Town}, {Model.EstablishmentDetails.Address.PostCode}")
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt id="app-school-details-school-type-key" class="govuk-summary-list__key app-school-details-summary-key">
                        School type
                    </dt>
                    <dd id="app-school-details-school-type-value" class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.EstablishmentType == null
                            ? string.Empty
                            : Model.EstablishmentDetails.EstablishmentType.Name)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Education phase
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @Model.EstablishmentDetails.PhaseOfEducation
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Gender of entry
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.Gender == null
                            ? string.Empty
                            : Model.EstablishmentDetails.Gender.Name)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Ofsted rating
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @if (Model.EstablishmentDetails.OfstedRating?.Code != null && Model.EstablishmentDetails.OfstedRating?.Code != "99")
                        {
                            <span class="app-ofsted-colour-rating app-ofsted-rating-@Model.EstablishmentDetails.OfstedRating?.Code">
                                @Model.EstablishmentDetails.OfstedRating?.Code
                            </span>
                            <span>
                                @Model.EstablishmentDetails.OfstedRating?.Name <wbr /> |
                                <a href="https://reports.ofsted.gov.uk/inspection-reports/find-inspection-report/provider/ELS/@Model.EstablishmentDetails.Urn" target="_blank" class="govuk-link">
                                    Ofsted report
                                </a>
                            </span>
                            if (Model.EstablishmentDetails.OfstedLastInspectionDate != null)
                            {
                                <span class="app-ofsted-last-inspection">Inspected @Model.EstablishmentDetails.OfstedLastInspectionDate.Value.ToString("dd MMMM yyyy")</span>
                            }
                        }
                        else if (Model.EstablishmentDetails.OfstedRating?.Code == "99")
                        {
                            <span>No data available</span>
                        }
                        else
                        {
                            <p class="app-ofsted-rating-description">
                                <span class="app-ofsted-colour-rating">--</span>
                                No Ofsted assessment published
                            </p>
                        }
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Local authority
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.LocalAuthority == null
                            ? string.Empty
                            : Model.EstablishmentDetails.LocalAuthority.Name)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Headteacher / Principal
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.HeadTeacher == null
                            ? string.Empty
                            : $"{Model.EstablishmentDetails.HeadTeacher.Title} {Model.EstablishmentDetails.HeadTeacher.FirstName} {Model.EstablishmentDetails.HeadTeacher.LastName}")
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Age range
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.AgeRange == null
                            ? string.Empty
                            : $"{Model.EstablishmentDetails.AgeRange.Low} to {Model.EstablishmentDetails.AgeRange.High}")
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Religious character
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.ReligiousDenomination == null
                            ? string.Empty
                            : Model.EstablishmentDetails.ReligiousDenomination.Name)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Admissions policy
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.AdmissionsPolicy == null
                            ? string.Empty
                            : Model.EstablishmentDetails.AdmissionsPolicy.Name)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        SEN unit or resourced provision
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.ResourcedProvisionType == null
                            ? string.Empty
                            : Model.EstablishmentDetails.ResourcedProvisionType.Name)
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key app-school-details-summary-key">
                        Number of pupils
                    </dt>
                    <dd class="govuk-summary-list__value">
                        @(Model.EstablishmentDetails.NoOfPupils.ToString() ?? string.Empty)
                    </dd>
                </div>
            </dl>
        </div>
    </details>
    <div class="govuk-width-container">
        <div id="app-card-container" class="app-grid-container-four-column app-grid-container--wider govuk-!-margin-top-5">
            @await Html.PartialAsync("~/Features/ContentTemplates/ContentTemplateView.cshtml", Model.ContentTemplate)
        </div>
    </div>
</div>