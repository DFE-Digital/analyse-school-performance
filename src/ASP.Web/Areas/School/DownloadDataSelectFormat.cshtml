@using ASP.Core.Utilities
@model ASP.Web.Areas.School.ViewModels.SchoolDownloadsSelectFormatViewModel
@{
    ViewData["Title"] = "Download data";
}

<div class="govuk-width-container app-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.SchoolPage.Breadcrumbs)
</div>

<div class="govuk-main-wrapper govuk-width-container">
    <h1 class="govuk-heading-xl">Download data</h1>
     <h2 id="school-name-heading" class="govuk-heading-m">
       @Model.SchoolPage.SchoolName <span class="govuk-!-font-weight-regular">(URN: @Model.SchoolPage.SchoolUrn)</span>
    </h2>
    @await Html.PartialAsync("~/Areas/Shared/Navigation/_SubMenuNavigationPartial.cshtml", Model.SchoolPage.SubNavigation)

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third app-side-navigation-width">
            @await Html.PartialAsync("~/Areas/Shared/Navigation/_SideMenuNavigationPartial.cshtml", Model.SchoolPage.SideNavigation)
        </div>
        <div class="govuk-grid-column-two-thirds">
            <h2 data-testid="available-downloads-format-heading" class="govuk-heading-l app-downloads">
                <span data-testid="available-downloads-format-name" class="govuk-caption-l">@Model.SchoolPage.SchoolName data</span>
                Download @Model.SchoolPage.SchoolName data
            </h2>
            <p class="govuk-body">You can download your requested data in CSV format.</p>
            <p class="govuk-body">The data included in your download is the pupil level / aggregated data for your school.</p>
            <ul class="govuk-list">
                    <li>
                    <img src="/assets/public/images/icons/download-icon.png" alt="download icon" class="app-icon-download">
                    @Html.ActionLink("Data in CSV format", "DownloadDataAsZip", Model.SchoolPage.Controller, new { FileType = "CSV", SelectedFiles = Model.SelectedFiles }, new { id = "app-available-downloads-format-csv-link", @class = "govuk-link" })
                        <span class="app-download-helptext">
                            (will download as a ZIP file; open the ZIP to access its contents)
                        </span>
                    </li>
            </ul>
            @Html.ActionLink("Download other dates", "DownloadDataSelectYear", Model.SchoolPage.Controller,null, new { id = "app-available-downloads-other-dates-link", role="button", @class = "govuk-button govuk-button--secondary govuk-!-margin-top-4" })
        </div>
    </div>
</div>
