@using ASP.Web.Areas.Search
@using ASP.Web.Areas.Shared.EstablishmentListing
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ASP.Web.Areas.Search.SearchViewModel
@{
    ViewData["Title"] = Model.TotalCount == 0 ? $"We found no matching results for \"{Model.SearchTerm}\"" : $"Search results for \"{Model.SearchTerm}\"";
}

<div class="govuk-width-container">
    @await Html.PartialAsync("_BreadcrumbTrailPartial", Model.Breadcrumbs)
</div>
<div class="govuk-width-container govuk-main-wrapper">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @await Html.PartialAsync("~/Areas/Search/_SearchResultNotFoundPartial.cshtml", new SearchResultNotFoundModel()
            {
                SearchTerm = Model.SearchTerm,
                TotalCount = Model.TotalCount
            })
        </div>
    </div>
    <div class="govuk-grid-row">
        @if (Model.TotalCount > 0)
        {
            <div class="govuk-grid-column-two-thirds">
                <h1 id="school-search-results-some-results-heading" class="govuk-heading-l school-name-heading">Search results for "@Model.SearchTerm"</h1>
                @if (Model.PaginationModel != null)
                {
                    <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml" model=@((Model.PaginationModel, "Header"))/>
                }
                @await Html.PartialAsync("~/Areas/Shared/EstablishmentListing/_EstablishmentListingPartial.cshtml", new EstablishmentListingViewModel(Model.EstablishmentListingsModel))
                @if (Model.PaginationModel != null)
                {
                    <partial name="~/Areas/Shared/Pagination/_PaginationPartial.cshtml" model=@((Model.PaginationModel, "Footer"))/>
                }
            </div>
        }
    </div>
</div>